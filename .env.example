# ==============================================================================
# HITUNGIN - Environment Variables Configuration (.env.example)
# ==============================================================================

# Backend API Service (Laravel)
VITE_API_BASE_URL=http://localhost:8000/api

# Application Metadata
VITE_APP_NAME="Hitungin"
VITE_APP_ENV="development"

# AI Inference Endpoints (Optional / Fallback)
# Mode default aplikasi menjalankan on-device inference (MediaPipe) dan modul AI client-side
VITE_AI_WHISPER_ENDPOINT=http://localhost:8000/api/ai/whisper
VITE_AI_CRNN_ENDPOINT=http://localhost:8000/api/ai/crnn
